# ==============================================================================
# Client-Side Environment Variables (Vite Frontend)
# Add these to your local .env file and Cloudflare Pages Environment Variables
# ==============================================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ==============================================================================
# Serverless / Edge Function Variables (Cloudflare Pages Functions)
# Configure these in Cloudflare Dashboard: Settings -> Environment variables
# DO NOT commit real keys to version control
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Outbound Email Dispatch for Password Recovery (Resend API)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=GMS SSLG Governance <noreply@yourdomain.com>
APP_URL=https://your-domain.pages.dev
